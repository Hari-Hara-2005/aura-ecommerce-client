# Clerk Authentication
# Get your keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=

# Razorpay Payment Gateway
# Get your Key ID from https://dashboard.razorpay.com/#/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Backend API Base URL (default uses dummyjson.com via axios)
# Replace with your backend URL when ready (e.g. http://localhost:5000/api)
VITE_API_BASE_URL=https://dummyjson.com
